# 所有域名均为占位示例，替换为你自己的镜像源；真实部署信息不要提交 Git。
# 生产部署只拉镜像。第一次 GitHub Actions 发布成功后可使用 latest。
# 也可以填写发布记录里的完整 sha 标签或 image@sha256:digest。
HERDRX_IMAGE=registry.example.com/herdrx/server:latest
HERDRX_BIND_ADDR=0.0.0.0
HERDRX_PORT=8080

# 默认 HTTP，可填写实际机器 IP，无需域名。自行配置 HTTPS 反向代理后再修改 URL 和 Secure Cookie。
HERDRX_PUBLIC_URL=http://127.0.0.1:8080
HERDRX_COOKIE_SECURE=false
# 注册默认关闭，由首位管理员在后台开启；设置保存在 ./data 中。
HERDRX_ALLOW_PRIVATE_HOSTS=true
HERDRX_SESSION_TTL=720h
HERDRX_AUTH_HASH_CONCURRENCY=2
# 全实例共享的远程连接与拨号上限；空闲连接在达到上限时优先回收。
HERDRX_HOST_DIAL_CONCURRENCY=4
HERDRX_MAX_HOST_CONNECTIONS=20
HERDRX_HOST_DIAL_TIMEOUT=30s
HERDRX_HOST_IDLE_TIMEOUT=2m

# 所有写接口与 WebSocket 校验精确来源。别名填完整 origin，以逗号分隔，无路径或通配符。
HERDRX_ALLOWED_ORIGINS=
# 直连时留空。外部代理填写其实际出口 IP/CIDR，不信任客户端自行提交的 X-Forwarded-For。
HERDRX_TRUSTED_PROXIES=

# 这些服务端参数用于 legacy 初始化命令；新版 connect 使用受控端保存的区域。
# 公共中继供试用；自建中继的配置边界见 docs/operations.md。
HERDRX_DERP_REGION_ID=304
HERDRX_DERP_HOST=
HERDRX_DERP_HOSTNAME=derp.example.com
